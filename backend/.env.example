# CONFIGURACIÓN GENERAL
DOCKER=0

# BASES DE DATOS - POSTGRESQL
PGHOST=tu_host_aqui
PGDATABASE=tu_nombre_de_base_de_datos_aqui
PGUSER=tu_usuario_de_base_de_datos_aqui
PGPASSWORD=tu_contraseña_de_base_de_datos_aqui

# CONFIGURACIÓN DE CORREO (SMTP)
EMAIL_HOST=tu_servidor_smtp_aqui
EMAIL_PORT=tu_puerto_smtp_aqui
EMAIL_USER=tu_correo_de_envio_aqui
EMAIL_PASSWORD=tu_contraseña_de_aplicacion_aqui

# CONFIGURACIÓN DE GEMINI - LLM
# La API key debe ser SOLO la clave de https://aistudio.google.com/apikey (ASCII, sin ñ ni tildes).
GEMINI_API_KEY=AIzaSy_tu_clave_real_aqui
GEMINI_MODEL=gemini-2.0-flash
PROMT_BASE="tu_prompt_base_de_instrucciones_aqui"
