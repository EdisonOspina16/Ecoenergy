    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "install:browsers": "playwright install chromium",
    "test:registro": "tsx tests-AI/tests/registro.e2e.ts",
    "test:login": "tsx tests-AI/tests/login.e2e.ts",
    "test:recuperar": "tsx tests-AI/tests/recuperar.e2e.ts",
    "test:crear-perfil": "tsx tests-AI/tests/crear-perfil.e2e.ts",
    "test:listar-dispositivos": "tsx tests-AI/tests/listar-dispositivos.e2e.ts",
    "test:suscripcion-correo": "tsx tests-AI/tests/suscripcion-correo.e2e.ts",
    "test:estado-dispositivos": "tsx tests-AI/tests/estado-dispositivos.e2e.ts",
    "test:cierre-sesion": "tsx tests-AI/tests/cierre-sesion.e2e.ts",
    "test:registrar-tomacorriente": "tsx tests-AI/tests/registrar-tomacorriente.e2e.ts",
    "test:lista-tomacorrientes": "tsx tests-AI/tests/lista-tomacorrientes.e2e.ts",
    "test:eliminar-tomacorriente": "tsx tests-AI/tests/eliminar-tomacorriente.e2e.ts",
    "test:all-ai": "tsx tests-AI/tests/registro.e2e.ts && tsx tests-AI/tests/login.e2e.ts && tsx tests-AI/tests/recuperar.e2e.ts && tsx tests-AI/tests/crear-perfil.e2e.ts && tsx tests-AI/tests/listar-dispositivos.e2e.ts && tsx tests-AI/tests/suscripcion-correo.e2e.ts && tsx tests-AI/tests/estado-dispositivos.e2e.ts && tsx tests-AI/tests/cierre-sesion.e2e.ts && tsx tests-AI/tests/registrar-tomacorriente.e2e.ts && tsx tests-AI/tests/lista-tomacorrientes.e2e.ts && tsx tests-AI/tests/eliminar-tomacorriente.e2e.ts",
    "cy:open": "cypress open --project test/cypress",
    "cy:run": "cypress run --project test/cypress",
    "cy:test": "start-server-and-test dev http://localhost:3000 cy:run"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "latest",
    "dotenv": "^16.6.1",
    "next": "^16.2.4",
