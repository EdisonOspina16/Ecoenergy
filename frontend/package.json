  "vitest": {
    "environment": "jsdom",
    "setupFiles": "./test/setupTests.ts"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "minimatch": ">=9.0.7",
    "serialize-javascript": ">=7.0.5",
    "diff": ">=9.0.0"
  }
}
